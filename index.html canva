   </div>
  </div>
  <script>
  const defaultConfig = {
    site_title: "NARESH BIKRAM RAI",
    site_subtitle: "Cinematic Travel Archive of Eastern Nepal",
    story_heading: "Welcome to my Cinematic Travel Journal",
    story_text: "I travel across Eastern Nepal documenting landscapes, trails, cultural stories, natural sounds, and the disappearing memories of our villages.",
    primary_color: "#6366f1",
    secondary_color: "#1a1a2e",
    text_color: "#ffffff",
    accent_color: "#8b5cf6"
  };

  async function onConfigChange(config) {
    const siteTitle = config.site_title || defaultConfig.site_title;
    const siteSubtitle = config.site_subtitle || defaultConfig.site_subtitle;
    const storyHeading = config.story_heading || defaultConfig.story_heading;
    const storyText = config.story_text || defaultConfig.story_text;

    document.getElementById('site-title').textContent = siteTitle;
    document.getElementById('site-subtitle').textContent = siteSubtitle;
    document.getElementById('story-heading').textContent = storyHeading;
    document.getElementById('story-text').textContent = storyText;
  }

  function mapToCapabilities(config) {
    return {
      recolorables: [],
      borderables: [],
      fontEditable: undefined,
      fontSizeable: undefined
    };
  }

  function mapToEditPanelValues(config) {
    return new Map([
      ["site_title", config.site_title || defaultConfig.site_title],
      ["site_subtitle", config.site_subtitle || defaultConfig.site_subtitle],
      ["story_heading", config.story_heading || defaultConfig.story_heading],
      ["story_text", config.story_text || defaultConfig.story_text]
    ]);
  }

  if (window.elementSdk) {
    window.elementSdk.init({
      defaultConfig,
      onConfigChange,
      mapToCapabilities,
      mapToEditPanelValues
    });
  }
</script>
