<!doctype html>
<html lang="ne">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cinematic Travel Archive</title>
  <script src="/_sdk/element_sdk.js"></script>
  <style>
    body {
      box-sizing: border-box;
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
      overflow-x: hidden;
    }

    body {
      font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #0d0d0d;
      color: #ffffff;
      line-height: 1.6;
    }

    .container {
      display: flex;
      min-height: 100%;
      flex-direction: row;
    }

    /* Sidebar Styles */
    .sidebar {
      width: 320px;
      background: linear-gradient(135deg, rgba(20, 20, 20, 0.98) 0%, rgba(15, 15, 15, 0.95) 100%);
      padding: 50px 40px;
      position: fixed;
      height: 100%;
      left: 0;
      top: 0;
      border-right: 2px solid rgba(16, 185, 129, 0.25);
      overflow-y: auto;
      z-index: 100;
      backdrop-filter: blur(20px);
      box-shadow: 8px 0 50px rgba(16, 185, 129, 0.08), inset -1px 0 0 rgba(16, 185, 129, 0.1);
    }

    .sidebar h1 {
      font-size: 26px;
      font-weight: 800;
      margin-bottom: 15px;
      line-height: 1.2;
      letter-spacing: 1px;
      background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-transform: uppercase;
    }

    .tagline {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.5);
      margin-bottom: 45px;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 500;
    }

    .nav-item {
      display: block;
      padding: 16px 24px;
      margin-bottom: 6px;
      color: rgba(255, 255, 255, 0.65);
      text-decoration: none;
      border-radius: 12px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      font-size: 15px;
      letter-spacing: 0.3px;
      position: relative;
      overflow: hidden;
      font-weight: 500;
      border: 1px solid transparent;
    }

    .nav-item::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 4px;
      height: 100%;
      background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
      transform: scaleY(0);
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      border-radius: 0 4px 4px 0;
    }

    .nav-item::after {
      content: '';
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%) translateX(-10px);
      width: 6px;
      height: 6px;
      background: #10b981;
      border-radius: 50%;
      opacity: 0;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .nav-item:hover {
      background: rgba(16, 185, 129, 0.1);
      color: #10b981;
      transform: translateX(8px);
      border-color: rgba(16, 185, 129, 0.3);
    }

    .nav-item:hover::before {
      transform: scaleY(1);
    }

    .nav-item:hover::after {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }

    /* Main Content Area */
    .main-content {
      margin-left: 320px;
      flex: 1;
      width: calc(100% - 320px);
    }

    /* Hero Section */
    .hero {
      position: relative;
      height: 100%;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: 
        radial-gradient(circle at 30% 50%, rgba(16, 185, 129, 0.2) 0%, transparent 40%),
        radial-gradient(circle at 70% 50%, rgba(5, 150, 105, 0.15) 0%, transparent 40%),
        radial-gradient(ellipse at top, rgba(16, 185, 129, 0.1) 0%, transparent 60%),
        linear-gradient(135deg, #0d0d0d 0%, #1a1a1a 100%);
    }

    .hero-background {
      position: absolute;
      inset: 0;
      background-image: 
        repeating-linear-gradient(90deg, rgba(16, 185, 129, 0.03) 0px, transparent 1px, transparent 60px, rgba(16, 185, 129, 0.03) 61px),
        repeating-linear-gradient(0deg, rgba(16, 185, 129, 0.03) 0px, transparent 1px, transparent 60px, rgba(16, 185, 129, 0.03) 61px);
      animation: gridMove 30s linear infinite;
    }

    @keyframes gridMove {
      0% { transform: translate(0, 0); }
      100% { transform: translate(60px, 60px); }
    }

    .mountain-silhouette {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 40%;
      background: linear-gradient(to top, rgba(13, 13, 13, 0.9) 0%, transparent 100%);
      clip-path: polygon(0 100%, 0 60%, 15% 75%, 25% 55%, 35% 70%, 50% 45%, 65% 65%, 75% 50%, 85% 70%, 100% 55%, 100% 100%);
      z-index: 1;
    }

    .hero-particles {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }

    .particle {
      position: absolute;
      width: 3px;
      height: 3px;
      background: rgba(16, 185, 129, 0.4);
      border-radius: 50%;
      animation: float 20s infinite ease-in-out;
    }

    .particle:nth-child(1) { left: 10%; top: 20%; animation-delay: 0s; }
    .particle:nth-child(2) { left: 30%; top: 40%; animation-delay: 2s; }
    .particle:nth-child(3) { left: 50%; top: 30%; animation-delay: 4s; }
    .particle:nth-child(4) { left: 70%; top: 50%; animation-delay: 6s; }
    .particle:nth-child(5) { left: 85%; top: 25%; animation-delay: 8s; }

    @keyframes float {
      0%, 100% { transform: translateY(0) translateX(0); opacity: 0.3; }
      50% { transform: translateY(-30px) translateX(20px); opacity: 0.8; }
    }

    .hero-overlay {
      position: relative;
      z-index: 2;
      text-align: center;
      padding: 80px 50px;
      max-width: 1000px;
      animation: fadeInUp 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(50px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .hero-badge {
      display: inline-block;
      padding: 8px 20px;
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 30px;
      color: #10b981;
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 30px;
      animation: pulse 3s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
      50% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
    }

    .hero-text h2 {
      font-size: 90px;
      font-weight: 900;
      margin-bottom: 30px;
      letter-spacing: -3px;
      background: linear-gradient(135deg, #ffffff 0%, #10b981 50%, #34d399 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.05;
      text-transform: uppercase;
      filter: drop-shadow(0 0 40px rgba(16, 185, 129, 0.4));
    }

    .hero-text p {
      font-size: 26px;
      color: rgba(255, 255, 255, 0.85);
      letter-spacing: 1px;
      font-weight: 400;
      line-height: 1.7;
      max-width: 750px;
      margin: 0 auto;
    }

    .scroll-indicator {
      position: absolute;
      bottom: 50px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      color: rgba(16, 185, 129, 0.8);
      animation: bounce 2.5s ease-in-out infinite;
      z-index: 3;
    }

    @keyframes bounce {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50% { transform: translateX(-50%) translateY(-15px); }
    }

    .mouse {
      width: 28px;
      height: 44px;
      border: 2px solid rgba(16, 185, 129, 0.6);
      border-radius: 18px;
      position: relative;
      box-shadow: 0 0 15px rgba(16, 185, 129, 0.2);
    }

    .wheel {
      width: 4px;
      height: 10px;
      background: rgba(16, 185, 129, 0.8);
      border-radius: 2px;
      position: absolute;
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
      animation: scroll 1.8s ease-in-out infinite;
    }

    @keyframes scroll {
      0%, 100% { opacity: 0; transform: translateX(-50%) translateY(0); }
      50% { opacity: 1; transform: translateX(-50%) translateY(10px); }
    }

    /* Story Section */
    .story-panel {
      background: 
        radial-gradient(ellipse at center, rgba(16, 185, 129, 0.08) 0%, transparent 60%),
        linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, transparent 50%),
        linear-gradient(to bottom, #0d0d0d 0%, #1a1a1a 100%);
      padding: 140px 90px;
      text-align: center;
      border-top: 2px solid rgba(16, 185, 129, 0.25);
      position: relative;
      overflow: hidden;
      box-shadow: inset 0 1px 0 rgba(16, 185, 129, 0.2);
    }

    .story-panel::before {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 4px;
      background: linear-gradient(90deg, transparent, #10b981, transparent);
    }

    .story-panel h3 {
      font-size: 48px;
      font-weight: 800;
      margin-bottom: 35px;
      color: #ffffff;
      letter-spacing: -1px;
      position: relative;
      display: inline-block;
    }

    .story-panel h3::after {
      content: '';
      position: absolute;
      bottom: -15px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 3px;
      background: linear-gradient(90deg, #10b981, #34d399);
      border-radius: 2px;
    }

    .story-panel p {
      font-size: 20px;
      color: rgba(255, 255, 255, 0.7);
      max-width: 850px;
      margin: 0 auto;
      line-height: 1.9;
      font-weight: 400;
    }

    /* Responsive Design */
    @media (max-width: 1024px) {
      .sidebar {
        width: 260px;
      }

      .main-content {
        margin-left: 260px;
        width: calc(100% - 260px);
      }

      .hero-text h2 {
        font-size: 64px;
      }

      .hero-text p {
        font-size: 20px;
      }

      .story-panel h3 {
        font-size: 40px;
      }

      .story-panel p {
        font-size: 18px;
      }
    }

    @media (max-width: 768px) {
      .container {
        flex-direction: column;
      }

      .sidebar {
        width: 100%;
        position: relative;
        height: auto;
        border-right: none;
        border-bottom: 1px solid rgba(16, 185, 129, 0.2);
        padding: 30px 25px;
      }

      .sidebar h1 {
        font-size: 20px;
        margin-bottom: 8px;
      }

      .tagline {
        font-size: 10px;
        margin-bottom: 25px;
      }

      .nav-item {
        padding: 12px 18px;
        font-size: 14px;
        margin-bottom: 4px;
      }

      .main-content {
        margin-left: 0;
        width: 100%;
      }

      .hero {
        min-height: 85%;
      }

      .hero-badge {
        font-size: 10px;
        padding: 6px 16px;
        margin-bottom: 20px;
      }

      .hero-text h2 {
        font-size: 36px;
        letter-spacing: -1px;
        margin-bottom: 18px;
      }

      .hero-text p {
        font-size: 16px;
        letter-spacing: 0.3px;
      }

      .hero-overlay {
        padding: 40px 25px;
      }

      .scroll-indicator {
        bottom: 30px;
        transform: translateX(-50%) scale(0.85);
      }

      .story-panel {
        padding: 60px 30px;
      }

      .story-panel h3 {
        font-size: 28px;
        margin-bottom: 25px;
      }

      .story-panel p {
        font-size: 16px;
        line-height: 1.7;
      }

      .mountain-silhouette {
        height: 30%;
      }
    }

    @media (max-width: 480px) {
      .sidebar {
        padding: 25px 20px;
      }

      .sidebar h1 {
        font-size: 18px;
      }

      .nav-item {
        padding: 10px 14px;
        font-size: 13px;
      }

      .hero-text h2 {
        font-size: 28px;
      }

      .hero-text p {
        font-size: 15px;
      }

      .story-panel {
        padding: 50px 25px;
      }

      .story-panel h3 {
        font-size: 24px;
      }

      .story-panel p {
        font-size: 15px;
      }
    }
  </style>
